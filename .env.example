# Telegram Bot Configuration
# Obtain your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Express Server Port
PORT=3000

# Video Constraints
# Maximum duration allowed in seconds (< 2 mins = 120s)
MAX_DURATION_SECONDS=120

# Maximum video file size in Megabytes (Telegram Bot API limit is 50MB)
MAX_FILE_SIZE_MB=50

# Local download storage directory (relative to project root)
# Videos are saved here temporarily, sent to the client, and immediately deleted
DOWNLOADS_DIR=./downloads

# Optional: Webhook URL if deploying in production (leave empty for long polling)
# WEBHOOK_URL=https://your-domain.com/webhook
